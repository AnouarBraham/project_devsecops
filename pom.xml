<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>                       <!-- Spring Boot parent: manages versions of all dependencies -->
        <relativePath/>
    </parent>

    <groupId>com.cybersecure</groupId>                  <!-- project group id (like a company/domain name) -->
    <artifactId>cybersecure-platform</artifactId>      <!-- project artifact id (the project name) -->
    <version>0.0.1-SNAPSHOT</version>                  <!-- project version (SNAPSHOT = in development) -->
    <name>cybersecure-platform</name>                  <!-- human-readable name -->
    <description>CyberSecure Platform</description>    <!-- short description of the project -->

    <properties>
        <java.version>21</java.version>                <!-- Java version used to compile and run the app -->
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>            <!-- web framework: REST controllers, embedded Tomcat -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>       <!-- exposes /actuator endpoints (health, metrics, etc.) -->
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>     <!-- formats metrics for Prometheus at /actuator/prometheus -->
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>       <!-- packages the app as a runnable jar with embedded server -->
            </plugin>
        </plugins>
    </build>
</project>